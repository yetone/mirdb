---
/**
 * Base layout wrapping every page.
 * Owner: Scenario 1 - Hero Section & Branding
 *
 * Includes: SEOHead, NavBar, main content slot, Footer.
 * Sets HTML lang, charset, viewport meta, and applies global styles.
 */
import { APP_NAME, APP_DESCRIPTION, SITE_URL } from '../utils/constants';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={APP_DESCRIPTION} />
    <meta property="og:title" content={APP_NAME} />
    <meta property="og:description" content={APP_DESCRIPTION} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE_URL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={APP_NAME} />
    <meta name="twitter:description" content={APP_DESCRIPTION} />
    <link rel="canonical" href={SITE_URL} />
    <title>{APP_NAME} - Persistent Key-Value Store</title>
  </head>
  <body>
    <slot />
  </body>
</html>
