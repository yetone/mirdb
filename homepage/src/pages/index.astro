---
/**
 * Main homepage assembling all section components.
 * Owner: First scenario builder
 *
 * Imports and arranges:
 * - Navigation
 * - Hero
 * - Features
 * - UsageExamples
 * - Architecture
 * - Installation
 * - Footer
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Features from '../components/Features.astro';
import UsageExamples from '../components/UsageExamples.astro';
import Architecture from '../components/Architecture.astro';
---

<BaseLayout>
  <main class="max-w-6xl mx-auto px-4 py-8">
    <!-- Hero Section placeholder -->
    <section id="hero" class="py-16 text-center">
      <h1 class="text-4xl font-bold mb-4">MirDB</h1>
      <p class="text-xl text-[var(--color-text-secondary)]">A Persistent Key-Value Store with Memcached Protocol</p>
    </section>

    <!-- Features Section -->
    <Features />

    <!-- Usage Examples section (Scenario 3) -->
    <UsageExamples />

    <!-- Architecture Section -->
    <Architecture />

    <!-- Placeholder for Installation section (Scenario 5) -->
    <section id="installation" class="py-16">
      <h2 class="text-2xl font-bold mb-8 text-center">Installation</h2>
      <p class="text-center text-[var(--color-text-secondary)]">Installation section coming soon...</p>
    </section>
  </main>

  <!-- Placeholder for Footer (Scenario 6) -->
  <footer class="py-8 border-t border-[var(--color-border)]">
    <p class="text-center text-[var(--color-text-secondary)]">Footer coming soon...</p>
  </footer>
</BaseLayout>
