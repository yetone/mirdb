---
/**
 * Main homepage assembling all section components.
 * Owner: First scenario builder
 *
 * Imports and arranges:
 * - Navigation
 * - Hero
 * - Features
 * - UsageExamples
 * - Architecture
 * - Installation
 * - Footer
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import UsageExamples from '../components/UsageExamples.astro';
import Architecture from '../components/Architecture.astro';
import Installation from '../components/Installation.astro';
import Footer from '../components/Footer.astro';
import DarkModeToggle from '../components/DarkModeToggle.astro';
---

<BaseLayout>
  <!-- Dark Mode Toggle - fixed position in top right -->
  <div class="fixed top-4 right-4 z-50" data-testid="dark-mode-toggle-container">
    <DarkModeToggle />
  </div>
  <main>
    <Hero />

    <!-- Features Section -->
    <Features />

    <!-- Usage Examples section (Scenario 3) -->
    <UsageExamples />

    <!-- Architecture Section -->
    <Architecture />

    <!-- Installation Section -->
    <Installation />
  </main>

  <!-- Footer Section -->
  <Footer />
</BaseLayout>
