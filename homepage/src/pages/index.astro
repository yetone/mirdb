---
/**
 * Main homepage assembling all section components.
 * Owner: First scenario builder
 *
 * Imports and arranges:
 * - Navigation
 * - Hero
 * - Features
 * - UsageExamples
 * - Architecture
 * - Installation
 * - Footer
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import UsageExamples from '../components/UsageExamples.astro';
import Architecture from '../components/Architecture.astro';
import Installation from '../components/Installation.astro';
---

<BaseLayout>
  <main>
    <Hero />

    <!-- Features Section -->
    <Features />

    <!-- Usage Examples section (Scenario 3) -->
    <UsageExamples />

    <!-- Architecture Section -->
    <Architecture />

    <!-- Installation Section -->
    <Installation />
  </main>
  <footer class="py-8 px-4 border-t border-[var(--color-border)] mt-auto">
    <div class="max-w-6xl mx-auto text-center text-[var(--color-text-secondary)]">
      <p>Footer coming soon...</p>
    </div>
  </footer>
</BaseLayout>
