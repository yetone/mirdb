---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Architecture from '../components/Architecture.astro';
import QuickStart from '../components/QuickStart.astro';
import Documentation from '../components/Documentation.astro';
import Comparison from '../components/Comparison.astro';
import '../styles/global.css';
---

<Layout title="MirDB - Persistent Key-Value Store with Memcached Compatibility">
  <Navigation />
  <main class="pt-16">
    <Hero />
    <Features />
    <Architecture />
    <QuickStart />
    <Comparison />
    <Documentation />

    <!-- Footer -->
    <footer data-testid="footer-section" class="bg-gray-950 text-gray-400 py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center md:text-left">
          <!-- License Information -->
          <div>
            <h3 class="text-white font-semibold mb-4">License</h3>
            <p data-testid="footer-license">
              MirDB is released under the <a href="https://opensource.org/licenses/MIT" data-testid="footer-license-link" class="text-blue-400 hover:text-blue-300" target="_blank" rel="noopener noreferrer">MIT License</a>
            </p>
          </div>

          <!-- GitHub Link -->
          <div>
            <h3 class="text-white font-semibold mb-4">Source Code</h3>
            <p>
              <a href="https://github.com/yetone/mirdb" data-testid="footer-github-link" class="text-blue-400 hover:text-blue-300" target="_blank" rel="noopener noreferrer">
                View on GitHub
              </a>
            </p>
          </div>

          <!-- Community Resources -->
          <div>
            <h3 class="text-white font-semibold mb-4">Community</h3>
            <ul class="space-y-2" data-testid="footer-community-links">
              <li>
                <a href="https://github.com/yetone/mirdb/blob/main/CONTRIBUTING.md" data-testid="footer-contributing-link" class="text-blue-400 hover:text-blue-300" target="_blank" rel="noopener noreferrer">
                  Contributing Guidelines
                </a>
              </li>
              <li>
                <a href="https://github.com/yetone/mirdb/issues" data-testid="footer-issues-link" class="text-blue-400 hover:text-blue-300" target="_blank" rel="noopener noreferrer">
                  Report Issues
                </a>
              </li>
              <li>
                <a href="https://github.com/yetone/mirdb/discussions" data-testid="footer-discussions-link" class="text-blue-400 hover:text-blue-300" target="_blank" rel="noopener noreferrer">
                  Discussions
                </a>
              </li>
            </ul>
          </div>
        </div>

        <!-- Copyright -->
        <div class="mt-8 pt-8 border-t border-gray-800 text-center">
          <p data-testid="footer-copyright" class="text-gray-500">
            © {new Date().getFullYear()} MirDB. Open source software.
          </p>
        </div>
      </div>
    </footer>
  </main>
</Layout>
