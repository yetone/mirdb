---
import Layout from '../layouts/Layout.astro';
import Features from '../components/Features.astro';
import Architecture from '../components/Architecture.astro';
import GettingStarted from '../components/GettingStarted.astro';
import CodeExamples from '../components/CodeExamples.astro';
import Configuration from '../components/Configuration.astro';
import ProjectStatus from '../components/ProjectStatus.astro';
---

<Layout title="MirDB - Persistent Key-Value Store with Memcached Protocol">
  <main>
    <!-- Navigation -->
    <nav class="navbar fixed top-0 left-0 right-0 z-50 bg-slate-900/95 backdrop-blur border-b border-slate-800">
      <div class="nav-container max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="#" class="nav-brand text-xl font-bold text-white">MirDB</a>
        <div class="nav-links flex gap-6">
          <a href="#features" class="nav-link text-slate-300 hover:text-white transition-colors">Features</a>
          <a href="#getting-started" class="nav-link text-slate-300 hover:text-white transition-colors">Getting Started</a>
          <a href="#configuration" class="nav-link text-slate-300 hover:text-white transition-colors">Configuration</a>
          <a href="https://github.com/yetone/mirdb" target="_blank" rel="noopener noreferrer" data-testid="nav-github-link" class="text-slate-300 hover:text-white transition-colors">GitHub</a>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <section id="hero" data-testid="hero-section" class="pt-32 pb-20 px-4 text-center bg-gradient-to-b from-slate-800 to-slate-900">
      <div class="max-w-4xl mx-auto">
        <h1 data-testid="product-name" class="text-4xl md:text-6xl font-bold mb-6 text-white">
          MirDB
        </h1>
        <p data-testid="tagline" class="text-xl md:text-2xl text-slate-300 mb-8">
          Persistent memcached, powered by Rust
        </p>
        <p class="text-lg text-slate-400 mb-10 max-w-2xl mx-auto">
          A high-performance, persistent key-value store that speaks the memcached protocol.
          Drop-in replacement with durable storage.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#getting-started"
            data-testid="get-started-btn"
            class="bg-orange-500 hover:bg-orange-600 text-white font-semibold py-3 px-8 rounded-lg transition-colors"
          >
            Get Started
          </a>
          <a
            href="https://github.com/yetone/mirdb"
            target="_blank"
            rel="noopener noreferrer"
            data-testid="github-link"
            class="border border-slate-600 hover:border-slate-500 text-slate-300 hover:text-white font-semibold py-3 px-8 rounded-lg transition-colors"
          >
            View on GitHub
          </a>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <Features />

    <!-- Architecture Section -->
    <Architecture />

    <!-- Getting Started Section -->
    <GettingStarted />

    <!-- Code Examples Section -->
    <CodeExamples />

    <!-- Configuration Section -->
    <Configuration />

    <!-- Project Status Section -->
    <ProjectStatus />

    <!-- Footer -->
    <footer data-testid="footer" class="py-12 px-4 border-t border-slate-800 bg-slate-900">
      <div class="max-w-6xl mx-auto">
        <!-- Footer Navigation -->
        <nav data-testid="footer-nav" class="flex flex-wrap justify-center gap-6 mb-8">
          <a href="#features" class="text-slate-300 hover:text-white transition-colors">Features</a>
          <a href="#architecture" class="text-slate-300 hover:text-white transition-colors">Architecture</a>
          <a href="#getting-started" class="text-slate-300 hover:text-white transition-colors">Getting Started</a>
          <a href="#configuration" class="text-slate-300 hover:text-white transition-colors">Configuration</a>
          <a href="#project-status" class="text-slate-300 hover:text-white transition-colors">Status</a>
        </nav>

        <!-- Repository Link and License -->
        <div class="text-center text-slate-400 space-y-4">
          <p>
            MirDB is open source software.
            <a
              href="https://github.com/yetone/mirdb"
              target="_blank"
              rel="noopener noreferrer"
              data-testid="footer-repo-link"
              class="text-orange-500 hover:text-orange-400"
            >
              View on GitHub
            </a>
          </p>
          <p data-testid="footer-license" class="text-sm">
            Released under the <a href="https://github.com/yetone/mirdb/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="text-orange-500 hover:text-orange-400">MIT License</a>
          </p>
        </div>
      </div>
    </footer>
  </main>
</Layout>

<style>
  /* Smooth scrolling behavior */
  html {
    scroll-behavior: smooth;
  }

  /* Active nav link styling */
  .nav-link.active {
    color: #f97316; /* orange-500 */
    font-weight: 600;
  }
</style>

<script>
  // Smooth scroll for navigation links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      const href = this.getAttribute('href');
      if (href && href !== '#') {
        e.preventDefault();
        const target = document.querySelector(href);
        if (target) {
          target.scrollIntoView({
            behavior: 'smooth'
          });
          // Update URL hash
          history.pushState(null, '', href);
        }
      } else if (href === '#') {
        e.preventDefault();
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
        history.pushState(null, '', window.location.pathname);
      }
    });
  });

  // Intersection Observer for active nav link highlighting
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('.nav-link');

  const observerOptions = {
    root: null,
    rootMargin: '-20% 0px -60% 0px',
    threshold: 0
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('id');

        // Remove active class from all nav links
        navLinks.forEach(link => {
          link.classList.remove('active');
        });

        // Add active class to the corresponding nav link
        const activeLink = document.querySelector(`.nav-link[href="#${id}"]`);
        if (activeLink) {
          activeLink.classList.add('active');
        }
      }
    });
  }, observerOptions);

  // Observe all sections
  sections.forEach(section => {
    observer.observe(section);
  });
</script>
