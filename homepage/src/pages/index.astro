---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import QuickStart from '../components/QuickStart.astro';
import Documentation from '../components/Documentation.astro';
import '../styles/global.css';
---

<Layout title="MirDB - Persistent Key-Value Store with Memcached Compatibility">
  <Navigation />
  <main class="pt-16">
    <Hero />
    <Features />
    <QuickStart />
    <Documentation />

    <!-- Footer -->
    <footer class="bg-gray-950 text-gray-400 py-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p>MirDB is released under the MIT License</p>
        <p class="mt-2">
          <a href="https://github.com/yetone/mirdb" class="text-blue-400 hover:text-blue-300">
            View on GitHub
          </a>
        </p>
      </div>
    </footer>
  </main>
</Layout>
