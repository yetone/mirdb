---
import Layout from '../layouts/Layout.astro';
import Features from '../components/Features.astro';
import Architecture from '../components/Architecture.astro';
import GettingStarted from '../components/GettingStarted.astro';
import CodeExamples from '../components/CodeExamples.astro';
import Configuration from '../components/Configuration.astro';
import ProjectStatus from '../components/ProjectStatus.astro';
---

<Layout title="MirDB - Persistent Key-Value Store with Memcached Protocol">
  <main>
    <!-- Navigation -->
    <nav class="navbar sticky top-0 left-0 right-0 z-50 bg-slate-900/95 backdrop-blur border-b border-slate-800">
      <div class="nav-container container max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="#" class="nav-brand text-xl font-bold text-white">MirDB</a>

        <!-- Desktop Navigation -->
        <ul class="nav-links hidden md:flex gap-6 list-none m-0 p-0">
          <li><a href="#features" class="nav-link text-slate-300 hover:text-white transition-colors">Features</a></li>
          <li><a href="#getting-started" class="nav-link text-slate-300 hover:text-white transition-colors">Getting Started</a></li>
          <li><a href="#configuration" class="nav-link text-slate-300 hover:text-white transition-colors">Configuration</a></li>
          <li><a href="https://github.com/yetone/mirdb" target="_blank" rel="noopener noreferrer" data-testid="nav-github-link" class="text-slate-300 hover:text-white transition-colors">GitHub</a></li>
        </ul>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          data-testid="mobile-menu-btn"
          class="md:hidden text-slate-300 hover:text-white p-2"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="hamburger-icon w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <svg class="close-icon hidden w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Mobile Menu -->
      <div
        id="mobile-menu"
        data-testid="mobile-menu"
        class="mobile-menu hidden md:hidden bg-slate-900/95 backdrop-blur border-b border-slate-800"
      >
        <div class="px-4 py-4 space-y-3">
          <a href="#features" class="mobile-nav-link block text-slate-300 hover:text-white transition-colors py-2">Features</a>
          <a href="#getting-started" class="mobile-nav-link block text-slate-300 hover:text-white transition-colors py-2">Getting Started</a>
          <a href="#configuration" class="mobile-nav-link block text-slate-300 hover:text-white transition-colors py-2">Configuration</a>
          <a href="https://github.com/yetone/mirdb" target="_blank" rel="noopener noreferrer" class="mobile-nav-link block text-slate-300 hover:text-white transition-colors py-2">GitHub</a>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <section id="hero" data-testid="hero-section" class="pt-32 pb-20 px-4 text-center bg-gradient-to-b from-slate-800 to-slate-900">
      <div class="container max-w-4xl mx-auto">
        <h1 data-testid="product-name" class="hero-title text-4xl md:text-6xl font-bold mb-6 text-white">
          MirDB
        </h1>
        <p data-testid="tagline" class="hero-tagline text-xl md:text-2xl text-slate-300 mb-8">
          Persistent memcached, powered by Rust
        </p>
        <p class="hero-description text-lg text-slate-400 mb-10 max-w-2xl mx-auto">
          A high-performance, persistent key-value store that speaks the memcached protocol.
          Drop-in replacement with durable storage.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#getting-started"
            data-testid="get-started-btn"
            class="bg-orange-500 hover:bg-orange-600 text-white font-semibold py-3 px-8 rounded-lg transition-colors"
          >
            Get Started
          </a>
          <a
            href="https://github.com/yetone/mirdb"
            target="_blank"
            rel="noopener noreferrer"
            data-testid="github-link"
            class="border border-slate-600 hover:border-slate-500 text-slate-300 hover:text-white font-semibold py-3 px-8 rounded-lg transition-colors"
          >
            View on GitHub
          </a>
        </div>
      </div>
    </section>

    <!-- Features Section -->
    <Features />

    <!-- Architecture Section -->
    <Architecture />

    <!-- Getting Started Section -->
    <GettingStarted />

    <!-- Code Examples Section -->
    <CodeExamples />

    <!-- Configuration Section -->
    <Configuration />

    <!-- Project Status Section -->
    <ProjectStatus />

    <!-- Footer -->
    <footer data-testid="footer-section" class="py-12 px-4 border-t border-slate-800 bg-slate-900">
      <div class="max-w-6xl mx-auto">
        <!-- Footer Navigation -->
        <nav data-testid="footer-nav" class="flex flex-wrap justify-center gap-6 mb-8">
          <a href="#features" class="text-slate-300 hover:text-white transition-colors">Features</a>
          <a href="#architecture" class="text-slate-300 hover:text-white transition-colors">Architecture</a>
          <a href="#getting-started" class="text-slate-300 hover:text-white transition-colors">Getting Started</a>
          <a href="#configuration" class="text-slate-300 hover:text-white transition-colors">Configuration</a>
          <a href="#project-status" class="text-slate-300 hover:text-white transition-colors">Status</a>
        </nav>

        <!-- Repository Link and License -->
        <div class="text-center text-slate-400 space-y-4">
          <p>
            MirDB is open source software.
            <a
              href="https://github.com/yetone/mirdb"
              target="_blank"
              rel="noopener noreferrer"
              data-testid="footer-repo-link"
              class="text-orange-500 hover:text-orange-400"
            >
              View on GitHub
            </a>
          </p>
          <p data-testid="footer-license" class="text-sm">
            Released under the <a href="https://github.com/yetone/mirdb/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="text-orange-500 hover:text-orange-400">MIT License</a>
          </p>
        </div>
      </div>
    </footer>
  </main>
</Layout>

<style>
  /* Smooth scrolling behavior */
  html {
    scroll-behavior: smooth;
  }

  /* Active nav link styling */
  .nav-link.active {
    color: #f97316; /* orange-500 */
    font-weight: 600;
  }
</style>

<script>
  // Mobile menu functionality
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = mobileMenuBtn?.querySelector('.hamburger-icon');
  const closeIcon = mobileMenuBtn?.querySelector('.close-icon');

  function toggleMobileMenu() {
    const isOpen = mobileMenu?.classList.contains('hidden') === false;

    if (isOpen) {
      closeMobileMenu();
    } else {
      openMobileMenu();
    }
  }

  function openMobileMenu() {
    mobileMenu?.classList.remove('hidden');
    hamburgerIcon?.classList.add('hidden');
    closeIcon?.classList.remove('hidden');
    mobileMenuBtn?.setAttribute('aria-expanded', 'true');
  }

  function closeMobileMenu() {
    mobileMenu?.classList.add('hidden');
    hamburgerIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
    mobileMenuBtn?.setAttribute('aria-expanded', 'false');
  }

  mobileMenuBtn?.addEventListener('click', toggleMobileMenu);

  // Close mobile menu when clicking a link
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', closeMobileMenu);
  });

  // Close mobile menu when clicking outside
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const navbar = document.querySelector('.navbar');
    if (navbar && !navbar.contains(target) && mobileMenu && !mobileMenu.classList.contains('hidden')) {
      closeMobileMenu();
    }
  });

  // Smooth scroll for navigation links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      const href = this.getAttribute('href');
      if (href && href !== '#') {
        e.preventDefault();
        const target = document.querySelector(href);
        if (target) {
          target.scrollIntoView({
            behavior: 'smooth'
          });
          // Update URL hash
          history.pushState(null, '', href);
        }
      } else if (href === '#') {
        e.preventDefault();
        window.scrollTo({
          top: 0,
          behavior: 'smooth'
        });
        history.pushState(null, '', window.location.pathname);
      }
    });
  });

  // Intersection Observer for active nav link highlighting
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('.nav-link');

  const observerOptions = {
    root: null,
    rootMargin: '-20% 0px -60% 0px',
    threshold: 0
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('id');

        // Remove active class from all nav links
        navLinks.forEach(link => {
          link.classList.remove('active');
        });

        // Add active class to the corresponding nav link
        const activeLink = document.querySelector(`.nav-link[href="#${id}"]`);
        if (activeLink) {
          activeLink.classList.add('active');
        }
      }
    });
  }, observerOptions);

  // Observe all sections
  sections.forEach(section => {
    observer.observe(section);
  });
</script>
