const iconSvg = iconMap[icon] || iconMap['protocol'];
---

<article class="feature-card p-6 rounded-lg bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 transition-all hover:shadow-lg hover:border-primary-500 dark:hover:border-primary-400">
  <div class="feature-icon text-primary-600 dark:text-primary-400 mb-4" set:html={iconSvg} aria-hidden="true"></div>
  <h3 class="feature-title text-xl font-semibold mb-2 text-gray-900 dark:text-gray-100">{title}</h3>
  <p class="feature-description text-gray-600 dark:text-gray-400">{description}</p>
  {link && (
    <a href={link} class="mt-4 inline-block text-primary-600 dark:text-primary-400 hover:underline">
      Learn more &rarr;
    </a>
  )}
</article>
