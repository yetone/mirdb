---
/**
 * Individual feature card component.
 * Owner: Scenario 2 - Features Section Display
 *
 * Props:
 * - icon: string (icon identifier)
 * - title: string
 * - description: string
 * - link?: string (optional documentation link)
 */
export interface Props {
  icon: string;
  title: string;
  description: string;
  link?: string;
}

const { icon, title, description, link } = Astro.props;

const iconMap: Record<string, string> = {
