---
interface CodeExample {
  id: string;
  title: string;
  description: string;
  command: string;
  response: string;
}

const examples: CodeExample[] = [
  {
    id: 'set',
    title: 'SET Command',
    description: 'Store a key-value pair with optional flags, TTL, and byte count',
    command: `set mykey 0 0 5\r\nhello\r\n`,
    response: 'STORED',
  },
  {
    id: 'get',
    title: 'GET Command',
    description: 'Retrieve the value associated with a key',
    command: 'get mykey',
    response: `VALUE mykey 0 5\r\nhello\r\nEND`,
  },
  {
    id: 'delete',
    title: 'DELETE Command',
    description: 'Remove a key-value pair from the store',
    command: 'delete mykey',
    response: 'DELETED',
  },
];
---

<section id="code-examples" class="py-20 px-4 bg-slate-800" data-testid="code-examples-section">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-center mb-4 text-white">
      Code Examples
    </h2>
    <p class="text-slate-400 text-center mb-12 max-w-2xl mx-auto">
      MirDB uses the standard memcached text protocol. Here are examples of common operations.
    </p>

    <div class="space-y-8">
      {examples.map((example) => (
        <div
          class="bg-slate-900 rounded-lg overflow-hidden"
          data-testid={`${example.id}-example`}
        >
          <div class="px-6 py-4 border-b border-slate-700">
            <h3 class="text-xl font-semibold text-white" data-testid="example-title">
              {example.title}
            </h3>
            <p class="text-slate-400 mt-1">
              {example.description}
            </p>
          </div>

          <div class="relative">
            <div class="absolute top-3 right-3 z-10">
              <button
                class="copy-button bg-slate-700 hover:bg-slate-600 text-slate-300 hover:text-white px-3 py-1.5 rounded text-sm font-medium transition-colors flex items-center gap-2"
                data-testid="copy-button"
                data-code={`# Command\n${example.command}\n\n# Response\n${example.response}`}
                aria-label={`Copy ${example.title} code`}
              >
                <svg class="copy-icon w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />
                </svg>
                <svg class="check-icon hidden w-4 h-4 text-green-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                <span class="button-text">Copy</span>
              </button>
            </div>

            <pre class="p-6 pr-24 overflow-x-auto text-sm leading-relaxed font-mono"><code class="text-slate-100"><span class="text-slate-500"># Command</span>
<span class="text-orange-400">{example.command}</span>

<span class="text-slate-500"># Response</span>
<span class="text-green-400">{example.response}</span></code></pre>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12 p-6 bg-slate-900 rounded-lg border border-slate-700">
      <h3 class="text-lg font-semibold text-white mb-3">Protocol Format Reference</h3>
      <div class="text-slate-300 space-y-2 text-sm">
        <p>
          <code class="bg-slate-800 px-2 py-0.5 rounded text-orange-400">set &lt;key&gt; &lt;flags&gt; &lt;ttl&gt; &lt;bytes&gt;\r\n&lt;data&gt;\r\n</code>
        </p>
        <p>
          <code class="bg-slate-800 px-2 py-0.5 rounded text-orange-400">get &lt;key&gt;</code>
        </p>
        <p>
          <code class="bg-slate-800 px-2 py-0.5 rounded text-orange-400">delete &lt;key&gt;</code>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  // Copy to clipboard functionality
  document.querySelectorAll('.copy-button').forEach((button) => {
    button.addEventListener('click', async () => {
      const code = button.getAttribute('data-code');
      if (!code) return;

      try {
        await navigator.clipboard.writeText(code);

        // Update button state
        button.setAttribute('data-copied', 'true');

        const copyIcon = button.querySelector('.copy-icon');
        const checkIcon = button.querySelector('.check-icon');
        const buttonText = button.querySelector('.button-text');

        if (copyIcon && checkIcon && buttonText) {
          copyIcon.classList.add('hidden');
          checkIcon.classList.remove('hidden');
          buttonText.textContent = 'Copied!';
        }

        // Reset after 2 seconds
        setTimeout(() => {
          button.setAttribute('data-copied', 'false');
          if (copyIcon && checkIcon && buttonText) {
            copyIcon.classList.remove('hidden');
            checkIcon.classList.add('hidden');
            buttonText.textContent = 'Copy';
          }
        }, 2000);
      } catch (err) {
        console.error('Failed to copy:', err);
      }
    });
  });
</script>

<style>
  pre {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    border: 1px solid #334155;
  }

  pre code {
    display: block;
    white-space: pre-wrap;
    word-break: break-all;
  }

  .copy-button:hover {
    transform: translateY(-1px);
  }

  .copy-button[data-copied="true"] {
    background-color: #166534;
  }
</style>
