---
/**
 * Quick start section with code examples.
 * Owner: Scenario 3 - Quick Start & Code Examples
 *
 * Includes:
 * - Installation tabs (cargo, docker, from source)
 * - Code editor-like display for commands
 * - Copy-to-clipboard button on each code block
 * - Visual feedback on copy action
 * - Basic usage examples (set, get, delete operations)
 */
import quickstartData from '../../data/quickstart.json';
import InstallTabs from './InstallTabs.astro';
import CodeBlock from './CodeBlock.astro';
import type { QuickStartData } from '../../types/index';
import '../../styles/global.css';
import '../../styles/theme.css';
import '../../styles/accessibility.css';

const data = quickstartData as QuickStartData;
---

<section id="quick-start" class="quickstart-section" aria-labelledby="quickstart-heading">
  <div class="quickstart-container">
    <div class="section-header">
      <h2 id="quickstart-heading" class="section-title">{data.sectionTitle}</h2>
      <p class="section-description">{data.sectionDescription}</p>
    </div>

    <div class="install-section" aria-label="Installation methods">
      <h3 class="subsection-title">Installation</h3>
      <InstallTabs methods={data.installMethods} />
    </div>

    <div class="usage-section" aria-label="Usage examples">
      <h3 class="subsection-title">Basic Usage</h3>
      <p class="subsection-description">
        Connect to MirDB using any Memcached-compatible client or
        <code class="inline-code">telnet</code>:
      </p>
      <div class="usage-grid">
        {data.usageExamples.map((example) => (
          <div class="usage-item">
            <CodeBlock
              id={`usage-${example.id}`}
              code={example.code}
              language={example.language}
              label={`${example.operation} — ${example.description}`}
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .quickstart-section {
    padding: var(--space-3xl) 0;
    background-color: var(--color-bg);
  }

  .quickstart-container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 var(--space-lg);
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .section-title {
    font-size: var(--font-size-3xl);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }

  .section-description {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 640px;
    margin: 0 auto;
  }

  .subsection-title {
    font-size: var(--font-size-xl);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-md);
  }

  .subsection-description {
    font-size: var(--font-size-md);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
  }

  .install-section {
    margin-bottom: var(--space-2xl);
  }

  .usage-section {
    margin-bottom: var(--space-xl);
  }

  .usage-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .usage-item {
    width: 100%;
  }

  .inline-code {
    background-color: var(--color-bg-alt);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    font-family: 'Fira Code', 'Cascadia Code', monospace;
    font-size: var(--font-size-sm);
  }
</style>
