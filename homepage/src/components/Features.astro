---
const features = [
  {
    id: 'memcached-protocol',
    title: 'Memcached Protocol Compatibility',
    description: 'Drop-in replacement for memcached with full protocol support. Use existing memcached clients and tools seamlessly.',
    icon: 'network',
  },
  {
    id: 'lsm-tree',
    title: 'LSM Tree Architecture',
    description: 'High-performance write-optimized storage using Log-Structured Merge Trees with configurable compaction strategies.',
    icon: 'tree',
  },
  {
    id: 'rust-performance',
    title: 'Rust Performance',
    description: 'Built with Rust for memory safety, zero-cost abstractions, and blazing-fast performance without garbage collection.',
    icon: 'bolt',
  },
  {
    id: 'wal',
    title: 'Write-Ahead Log',
    description: 'Durable writes with Write-Ahead Logging ensure data safety even during unexpected shutdowns or crashes.',
    icon: 'shield',
  },
  {
    id: 'compaction',
    title: 'Configurable Compaction',
    description: 'Fine-tune compaction strategies to balance write amplification, space usage, and read performance.',
    icon: 'cog',
  },
  {
    id: 'toml-config',
    title: 'Simple TOML Configuration',
    description: 'Easy-to-read TOML configuration files make deployment and tuning straightforward.',
    icon: 'document',
  },
];
---

<section id="features" class="py-16 bg-gray-900" data-testid="features-section">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-100 sm:text-4xl">Key Features</h2>
      <p class="mt-4 text-xl text-gray-400">
        Everything you need for high-performance persistent key-value storage
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" data-testid="features-grid">
      {features.map((feature) => (
        <div
          class="feature-card bg-gray-800 rounded-lg p-6 hover:bg-gray-750 transition-colors duration-300 border border-gray-700"
          data-testid={`feature-card-${feature.id}`}
        >
          <div class="feature-icon w-12 h-12 bg-blue-900 rounded-lg flex items-center justify-center mb-4" data-testid={`feature-icon-${feature.id}`}>
            {feature.icon === 'network' && (
              <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            )}
            {feature.icon === 'tree' && (
              <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />
              </svg>
            )}
            {feature.icon === 'bolt' && (
              <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            )}
            {feature.icon === 'shield' && (
              <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            )}
            {feature.icon === 'cog' && (
              <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            )}
            {feature.icon === 'document' && (
              <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            )}
          </div>
          <h3 class="feature-title text-xl font-semibold text-gray-100 mb-2" data-testid={`feature-title-${feature.id}`}>
            {feature.title}
          </h3>
          <p class="feature-description text-gray-400" data-testid={`feature-description-${feature.id}`}>
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
