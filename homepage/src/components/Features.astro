---
/**
 * Features section with grid of feature cards.
 * Owner: Scenario 2 - Features Section Display
 *
 * Features:
 * - Grid layout (3 cols desktop, 2 cols tablet, 1 col mobile)
 * - 6 FeatureCard components
 * - Section heading and description
 *
 * Imports: FeatureCard, features.json content
 */
import FeatureCard from './FeatureCard.astro';
import features from '../content/features.json';
---

<section id="features" class="py-16 px-4 bg-white dark:bg-gray-900">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-4">Key Features</h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        MirDB combines the simplicity of Memcached with the durability of persistent storage,
        powered by modern LSM-tree architecture.
      </p>
    </div>
    <div class="features-grid grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feature) => (
        <FeatureCard
          icon={feature.icon}
          title={feature.title}
          description={feature.description}
        />
      ))}
    </div>
  </div>
</section>
