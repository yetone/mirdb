---
/**
 * Architecture overview section.
 * Owner: Scenario 4 - Architecture Overview Section
 *
 * Features:
 * - Data flow diagram (SVG or image)
 * - LSM-tree architecture explanation
 * - Component descriptions (memtable, SSTable, WAL)
 * - Link to detailed documentation
 * - Accessible diagram with alt text
 */
import { GITHUB_URL } from '../utils/constants';

const architectureDocUrl = `${GITHUB_URL}#architecture`;
---

<section id="architecture" class="py-16 px-4 bg-gray-50 dark:bg-gray-800">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-4">Architecture Overview</h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        MirDB uses a Log-Structured Merge-tree (LSM-tree) architecture that provides excellent write performance
        while maintaining efficient read operations through multiple levels of storage.
      </p>
    </div>

    <div class="architecture-content grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
      <!-- Data Flow Diagram -->
      <div class="architecture-diagram bg-white dark:bg-gray-900 rounded-lg p-6 shadow-lg">
        <h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-4">Data Flow</h3>
        <div class="diagram-container">
          <img
            src="/architecture-diagram.svg"
            alt="MirDB data flow diagram showing the path from Client through Memcached Protocol Parser to Memtable, then through Immutable Memtable to SSTable levels via compaction"
            class="w-full h-auto architecture-diagram-img"
            loading="lazy"
          />
        </div>
      </div>

      <!-- LSM-tree Explanation -->
      <div class="architecture-explanation">
        <h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-4">LSM-tree Architecture</h3>

        <div class="space-y-4">
          <div class="component-description bg-white dark:bg-gray-900 rounded-lg p-4 shadow">
            <h4 class="font-semibold text-sky-600 dark:text-sky-400 mb-2">Memtable (Active)</h4>
            <p class="text-gray-600 dark:text-gray-400 text-sm">
              The active memtable is an in-memory data structure (skip list) that handles all incoming write operations.
              New key-value pairs are first written here for fast write performance. When it reaches the configured
              size limit (default 4MB), it becomes immutable.
            </p>
          </div>

          <div class="component-description bg-white dark:bg-gray-900 rounded-lg p-4 shadow">
            <h4 class="font-semibold text-sky-600 dark:text-sky-400 mb-2">Immutable Memtable</h4>
            <p class="text-gray-600 dark:text-gray-400 text-sm">
              Once a memtable is full, it transitions to an immutable state and joins a queue awaiting compaction.
              A new empty memtable is created to continue accepting writes. This allows writes to continue
              uninterrupted while the background compaction process flushes data to disk.
            </p>
          </div>

          <div class="component-description bg-white dark:bg-gray-900 rounded-lg p-4 shadow">
            <h4 class="font-semibold text-sky-600 dark:text-sky-400 mb-2">SSTable (Sorted String Table)</h4>
            <p class="text-gray-600 dark:text-gray-400 text-sm">
              SSTables are immutable, sorted files stored on disk. Data is organized into multiple levels:
              Level 0 contains recently flushed data (may overlap), while higher levels contain merged,
              non-overlapping data. Major compaction merges SSTables between levels to optimize read performance.
            </p>
          </div>
        </div>

        <div class="mt-6">
          <a
            href={architectureDocUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="architecture-doc-link inline-flex items-center text-sky-600 dark:text-sky-400 hover:text-sky-700 dark:hover:text-sky-300 font-medium"
          >
            View detailed architecture documentation
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
