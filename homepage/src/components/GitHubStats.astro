---
import { fetchGitHubStats, formatNumber } from '../lib/github';

const stats = await fetchGitHubStats();
---

<div class="github-stats flex flex-wrap justify-center gap-4 mt-8" data-testid="github-stats-section">
  <!-- Stars -->
  <a
    href="https://github.com/yetone/mirdb/stargazers"
    target="_blank"
    rel="noopener noreferrer"
    class="stat-item flex items-center gap-2 px-4 py-2 bg-gray-800 hover:bg-gray-700 rounded-lg transition-colors border border-gray-700"
    data-testid="github-stats-stars"
  >
    <svg class="w-5 h-5 text-yellow-400" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
    </svg>
    <span class="text-gray-300 font-medium" data-testid="github-stats-stars-count">
      {formatNumber(stats.stars)} stars
    </span>
  </a>

  <!-- Contributors -->
  <a
    href="https://github.com/yetone/mirdb/graphs/contributors"
    target="_blank"
    rel="noopener noreferrer"
    class="stat-item flex items-center gap-2 px-4 py-2 bg-gray-800 hover:bg-gray-700 rounded-lg transition-colors border border-gray-700"
    data-testid="github-stats-contributors"
  >
    <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
    </svg>
    <span class="text-gray-300 font-medium" data-testid="github-stats-contributors-count">
      {stats.contributors} contributors
    </span>
  </a>

  <!-- Latest Release -->
  {stats.latestRelease && (
    <a
      href="https://github.com/yetone/mirdb/releases/latest"
      target="_blank"
      rel="noopener noreferrer"
      class="stat-item flex items-center gap-2 px-4 py-2 bg-gray-800 hover:bg-gray-700 rounded-lg transition-colors border border-gray-700"
      data-testid="github-stats-release"
    >
      <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
      </svg>
      <span class="text-gray-300 font-medium" data-testid="github-stats-release-version">
        {stats.latestRelease}
      </span>
    </a>
  )}
</div>

<!-- Hidden metadata for testing that stats were fetched -->
<meta name="github-stats-fetched-at" content={stats.fetchedAt} data-testid="github-stats-metadata" />
