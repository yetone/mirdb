---
const docs = [
  {
    id: 'configuration',
    title: 'Configuration Reference',
    description: 'Complete guide to configuring MirDB with all available options for server, storage, and compaction settings.',
    icon: 'cog',
    link: '#quick-start',
  },
  {
    id: 'protocol',
    title: 'Memcached Protocol',
    description: 'Learn about memcached protocol compatibility, supported commands, and how to connect using existing clients.',
    icon: 'terminal',
    link: 'https://github.com/pjtatlow/mirdb#readme',
  },
  {
    id: 'deployment',
    title: 'Deployment Guide',
    description: 'Best practices for deploying MirDB in production environments, including performance tuning and monitoring.',
    icon: 'cloud',
    link: 'https://github.com/pjtatlow/mirdb#readme',
  },
];
---

<section id="documentation" class="py-16 bg-white dark:bg-gray-900" data-testid="documentation-section">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100 sm:text-4xl">Documentation</h2>
      <p class="mt-4 text-xl text-gray-500 dark:text-gray-400">
        Everything you need to deploy and operate MirDB
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-testid="documentation-grid">
      {docs.map((doc) => (
        <a
          href={doc.link}
          class="block bg-gray-50 dark:bg-gray-800 rounded-lg p-6 hover:bg-gray-100 dark:hover:bg-gray-750 transition-colors duration-300 border border-gray-200 dark:border-gray-700 group"
          data-testid={`doc-card-${doc.id}`}
          target={doc.link.startsWith('http') ? '_blank' : undefined}
          rel={doc.link.startsWith('http') ? 'noopener noreferrer' : undefined}
        >
          <div class="doc-icon w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center mb-4" data-testid={`doc-icon-${doc.id}`}>
            {doc.icon === 'cog' && (
              <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            )}
            {doc.icon === 'terminal' && (
              <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            )}
            {doc.icon === 'cloud' && (
              <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
              </svg>
            )}
          </div>
          <h3 class="doc-title text-xl font-semibold text-gray-900 dark:text-gray-100 mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors" data-testid={`doc-title-${doc.id}`}>
            {doc.title}
          </h3>
          <p class="doc-description text-gray-500 dark:text-gray-400" data-testid={`doc-description-${doc.id}`}>
            {doc.description}
          </p>
          <div class="mt-4 text-blue-600 dark:text-blue-400 flex items-center gap-1 text-sm group-hover:gap-2 transition-all">
            Learn more
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
