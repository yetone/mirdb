---
/**
 * Hero section component.
 * Owner: Scenario 1 - Hero Section & Branding
 *
 * Expected content:
 * - Product name "MirDB" as primary headline
 * - Value-proposition subheadline
 * - Primary CTA: "Get Started" linking to #quick-start
 * - Secondary CTA: "View on GitHub" linking to repo
 * - Logo image (assets/logo.gif)
 */
import Container from '../common/Container.astro';
import Button from '../common/Button.astro';
import { APP_NAME, APP_TAGLINE, GITHUB_REPO_URL, SECTION_IDS } from '../../utils/constants';
---
<section id={SECTION_IDS.HERO} class="hero">
  <Container>
    <div class="hero-content">
      <img
        src="/assets/logo.gif"
        alt={`${APP_NAME} logo`}
        class="hero-logo"
        width="96"
        height="96"
      />
      <h1 class="hero-headline">{APP_NAME}</h1>
      <p class="hero-tagline">{APP_TAGLINE}</p>
      <p class="hero-description">
        A high-performance, persistent key-value store written in Rust. MirDB speaks the Memcached
        protocol while storing data durably on disk using LSM tree architecture with skip-list
        memtables and write-ahead logging.
      </p>
      <div class="hero-ctas">
        <Button href={`#${SECTION_IDS.QUICK_START}`} variant="primary">
          Get Started
        </Button>
        <Button href={GITHUB_REPO_URL} variant="secondary" target="_blank" rel="noopener noreferrer">
          View on GitHub
        </Button>
      </div>
    </div>
  </Container>
</section>

<style>
  .hero {
    padding-top: var(--space-24);
    padding-bottom: var(--space-24);
    padding-left: var(--container-padding);
    padding-right: var(--container-padding);
    min-height: 80vh;
    display: flex;
    align-items: center;
    text-align: center;
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(56, 139, 253, 0.08), transparent),
      var(--color-bg-primary);
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .hero-logo {
    width: 96px;
    height: 96px;
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-2);
  }

  .hero-headline {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: var(--font-weight-extrabold);
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .hero-tagline {
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    color: var(--color-accent-primary-hover);
    font-weight: var(--font-weight-medium);
    margin-bottom: 0;
    max-width: 600px;
  }

  .hero-description {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    max-width: 680px;
    margin-bottom: 0;
    line-height: var(--line-height-relaxed);
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-4);
  }

  .hero-ctas .btn {
    padding: var(--space-4) var(--space-8);
    font-size: var(--font-size-lg);
    border-radius: var(--radius-lg);
  }

  @media (max-width: 767px) {
    .hero {
      padding-top: var(--space-16);
      padding-bottom: var(--space-16);
      min-height: 70vh;
    }

    .hero-ctas {
      flex-direction: column;
      width: 100%;
      max-width: 300px;
    }

    .hero-ctas .btn {
      width: 100%;
    }
  }
</style>
