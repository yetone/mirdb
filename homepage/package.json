{
  "name": "mirdb-homepage",
  "version": "1.0.0",
  "description": "Product Homepage for MirDB - Persistent Key-Value Store with Memcached Protocol",
  "main": "index.html",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "serve": "npx serve . -l 3000",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.4.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "playwright": "^1.57.0",
    "serve": "^14.2.5"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ],
    "moduleFileExtensions": [
      "js",
      "html"
    ],
    "verbose": true
  },
  "keywords": [
    "mirdb",
    "memcached",
    "key-value-store",
    "persistent-storage",
    "homepage"
  ],
  "license": "MIT"
}
