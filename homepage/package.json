{
  "name": "mirdb-homepage",
  "version": "1.0.0",
  "description": "Homepage for MirDB - A Persistent Key-Value Store",
  "main": "index.html",
  "scripts": {
    "serve": "npx http-server . -p 8080 -c-1",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=tests/unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=tests/integration --forceExit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lighthouse": "lighthouse http://localhost:8080 --output html --output-path ./lighthouse-report.html",
    "build": "echo 'Static site - no build required' && npm run validate",
    "validate": "npm run test:unit && npm run test:integration",
    "deploy:check": "npm run validate && echo 'Site is ready for deployment'"
  },
  "keywords": [
    "mirdb",
    "key-value-store",
    "memcached",
    "rust",
    "homepage"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "gifsicle": "^7.0.1",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lighthouse": "^13.0.3"
  }
}
