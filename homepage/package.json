{
  "name": "mirdb-homepage",
  "version": "1.0.0",
  "description": "MirDB Homepage - A static, responsive landing page",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "jest tests/unit",
    "test:e2e": "node ./node_modules/.bin/playwright test",
    "test:a11y": "jest tests/unit/accessibility.test.js",
    "test:perf:unit": "jest tests/unit/performance.test.js",
    "test:perf:e2e": "node ./node_modules/.bin/playwright test tests/e2e/performance.spec.js",
    "test:perf": "npm run test:perf:unit && npm run test:perf:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@axe-core/playwright": "^4.8.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^24.0.0",
    "axe-core": "^4.8.2"
  },
  "keywords": [
    "mirdb",
    "homepage",
    "landing-page"
  ],
  "license": "MIT"
}
