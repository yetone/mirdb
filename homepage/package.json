{
  "name": "mirdb-homepage-tests",
  "version": "1.0.0",
  "description": "Tests for MirDB Homepage",
  "scripts": {
    "build": "/tmp/zola build",
    "serve": "npx http-server public -p 8080 -s",
    "test": "jest --verbose",
