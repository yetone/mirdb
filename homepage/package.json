{
  "name": "mirdb-homepage",
  "version": "1.0.0",
  "description": "MirDB Homepage - Persistent Key-Value Store",
  "scripts": {
    "dev": "npx http-server . -p 8080 -c-1",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "npx playwright test --config=tests/playwright.config.ts --project=chromium",
    "test:unit": "npx vitest run --config=tests/vitest.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "http-server": "^14.1.1",
    "vitest": "^1.4.0",
    "jsdom": "^24.0.0"
  }
}
