{
  "name": "mirdb-homepage",
  "version": "1.0.0",
  "description": "MiRDB Product Homepage - Persistent Key-Value Store with Memcached Protocol",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.js",
    "test:unit": "jest --config tests/unit/jest.config.cjs",
    "serve": "npx serve . -l 3000",
    "serve:bg": "npx serve . -l 3000 &"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@babel/preset-env": "^7.24.0",
    "serve": "^14.2.0"
  },
  "keywords": [
    "mirdb",
    "key-value-store",
    "memcached",
    "database",
    "rust"
  ],
  "license": "MIT"
}
