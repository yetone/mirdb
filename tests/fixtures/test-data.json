{
  "projectName": "MirDB",
  "tagline": "A Persistent Key-Value Store with Memcached Protocol",
  "githubUrl": "https://github.com/yetone/mirdb",
  "version": "0.0.1",
  "author": "yetone",
  "authorEmail": "yetoneful@gmail.com",
  "features": [
    "Memcached Protocol Compatibility",
    "LSM-tree Storage Engine",
    "Skip-list Memtable",
    "WAL Durability",
    "SSTable Storage",
    "Minor/Major Compaction",
    "TTL Support"
  ],
  "memcachedPort": 11211,
  "defaultConfig": {
    "addr": "0.0.0.0:12333",
    "max_level": 7,
    "work_dir": "/tmp/mirdb"
  }
}
