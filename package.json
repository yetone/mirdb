{
  "name": "mirdb-homepage",
  "version": "1.0.0",
  "description": "MirDB Product Homepage",
  "scripts": {
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "playwright test tests/e2e"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "@playwright/test": "^1.40.0",
    "axe-core": "^4.8.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": ["tests"],
    "testMatch": ["**/*.test.js"],
    "collectCoverageFrom": [
      "js/**/*.js",
      "!js/main.js"
    ]
  }
}
