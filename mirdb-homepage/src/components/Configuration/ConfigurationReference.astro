---
/**
 * Configuration Reference Section.
 * Owner: Scenario 5 - Configuration Reference Section
 *
 * Features:
 * - Collapsible sections for config categories
 * - TOML example with syntax highlighting
 * - Option descriptions with default values
 * - Size unit explanations (K, M, G, T)
 */

import { CollapsibleSection } from './CollapsibleSection';

// TOML configuration example
const tomlExample = `addr = "0.0.0.0:12333"

max_level = 7
work_dir = "/tmp/mirdb"

sst_max_size = "100M"
mem_table_max_size = "4M"
mem_table_max_height = 32

imm_mem_table_max_count = 16

block_size = "4K"
block_restart_interval = 16

l0_compaction_trigger = 4

thread_sleep_ms = 500`;

// Configuration option categories
const networkOptions = [
  {
    name: 'addr',
    type: 'string',
    default: '0.0.0.0:12333',
    description: 'Listen address and port for Memcached protocol connections',
  },
];

const storageOptions = [
  {
    name: 'work_dir',
    type: 'string',
    default: '/tmp/mirdb',
    description: 'Data directory path where SSTables and WAL files are stored',
  },
  {
    name: 'max_level',
    type: 'integer',
    default: '7',
    description: 'Maximum number of LSM tree levels for organizing SSTables',
  },
];

const memtableOptions = [
  {
    name: 'mem_table_max_size',
    type: 'size',
    default: '4M',
    description: 'Maximum memtable size before flushing to disk as SSTable',
  },
  {
    name: 'mem_table_max_height',
    type: 'integer',
    default: '32',
    description: 'Maximum height for skip list data structure in memtable',
  },
  {
    name: 'imm_mem_table_max_count',
    type: 'integer',
    default: '16',
    description: 'Maximum number of immutable memtables queued for flush',
  },
];

const sstableOptions = [
  {
    name: 'sst_max_size',
    type: 'size',
    default: '100M',
    description: 'Maximum file size for individual SSTable files',
  },
  {
    name: 'block_size',
    type: 'size',
    default: '4K',
    description: 'Size of data blocks within SSTable files',
  },
  {
    name: 'block_restart_interval',
    type: 'integer',
    default: '16',
    description: 'Key prefix restart interval for block compression',
  },
];

const compactionOptions = [
  {
    name: 'l0_compaction_trigger',
    type: 'integer',
    default: '4',
    description: 'Number of Level 0 files that trigger compaction',
  },
  {
    name: 'thread_sleep_ms',
    type: 'integer',
    default: '500',
    description: 'Background thread sleep interval in milliseconds',
  },
];

const sizeUnits = [
  { unit: 'K', name: 'Kilobytes', bytes: '1,024 bytes' },
  { unit: 'M', name: 'Megabytes', bytes: '1,048,576 bytes' },
  { unit: 'G', name: 'Gigabytes', bytes: '1,073,741,824 bytes' },
  { unit: 'T', name: 'Terabytes', bytes: '1,099,511,627,776 bytes' },
];
---

<section id="configuration" class="py-16 px-4" data-testid="configuration-section">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-2xl font-bold font-mono text-text-primary mb-2 text-center">
      Configuration Reference
    </h2>
    <p class="text-text-secondary text-center mb-8">
      Configure MirDB using a TOML configuration file for optimal performance.
    </p>

    <!-- TOML Example Code Block -->
    <div class="mb-8" data-testid="toml-example">
      <h3 class="text-lg font-mono text-text-primary mb-3">Example Configuration</h3>
      <div class="relative">
        <pre class="bg-surface border border-border rounded-lg p-4 overflow-x-auto" data-testid="toml-code-block" data-language="toml">
          <code class="text-sm font-mono text-text-primary syntax-highlighted" data-testid="toml-highlighted-code">{tomlExample}</code>
        </pre>
      </div>
    </div>

    <!-- Collapsible Configuration Sections -->
    <div class="space-y-2" data-testid="config-categories">
      <!-- Network Configuration -->
      <CollapsibleSection title="Network" defaultOpen={true} testId="config-network" client:load>
        <div class="overflow-x-auto" data-testid="network-options">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-text-secondary text-left">
                <th class="pb-2 pr-4">Option</th>
                <th class="pb-2 pr-4">Type</th>
                <th class="pb-2 pr-4">Default</th>
                <th class="pb-2">Description</th>
              </tr>
            </thead>
            <tbody>
              {networkOptions.map((opt) => (
                <tr class="border-t border-border" data-testid={`option-${opt.name}`}>
                  <td class="py-2 pr-4 font-mono text-accent">{opt.name}</td>
                  <td class="py-2 pr-4 text-text-secondary">{opt.type}</td>
                  <td class="py-2 pr-4 font-mono text-success" data-testid={`default-${opt.name}`}>{opt.default}</td>
                  <td class="py-2 text-text-primary">{opt.description}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </CollapsibleSection>

      <!-- Storage Configuration -->
      <CollapsibleSection title="Storage" testId="config-storage" client:load>
        <div class="overflow-x-auto" data-testid="storage-options">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-text-secondary text-left">
                <th class="pb-2 pr-4">Option</th>
                <th class="pb-2 pr-4">Type</th>
                <th class="pb-2 pr-4">Default</th>
                <th class="pb-2">Description</th>
              </tr>
            </thead>
            <tbody>
              {storageOptions.map((opt) => (
                <tr class="border-t border-border" data-testid={`option-${opt.name}`}>
                  <td class="py-2 pr-4 font-mono text-accent">{opt.name}</td>
                  <td class="py-2 pr-4 text-text-secondary">{opt.type}</td>
                  <td class="py-2 pr-4 font-mono text-success" data-testid={`default-${opt.name}`}>{opt.default}</td>
                  <td class="py-2 text-text-primary">{opt.description}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </CollapsibleSection>

      <!-- Memory Tables Configuration -->
      <CollapsibleSection title="Memory Tables" testId="config-memtable" client:load>
        <div class="overflow-x-auto" data-testid="memtable-options">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-text-secondary text-left">
                <th class="pb-2 pr-4">Option</th>
                <th class="pb-2 pr-4">Type</th>
                <th class="pb-2 pr-4">Default</th>
                <th class="pb-2">Description</th>
              </tr>
            </thead>
            <tbody>
              {memtableOptions.map((opt) => (
                <tr class="border-t border-border" data-testid={`option-${opt.name}`}>
                  <td class="py-2 pr-4 font-mono text-accent">{opt.name}</td>
                  <td class="py-2 pr-4 text-text-secondary">{opt.type}</td>
                  <td class="py-2 pr-4 font-mono text-success" data-testid={`default-${opt.name}`}>{opt.default}</td>
                  <td class="py-2 text-text-primary">{opt.description}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </CollapsibleSection>

      <!-- SSTable Configuration -->
      <CollapsibleSection title="SSTables" testId="config-sstable" client:load>
        <div class="overflow-x-auto" data-testid="sstable-options">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-text-secondary text-left">
                <th class="pb-2 pr-4">Option</th>
                <th class="pb-2 pr-4">Type</th>
                <th class="pb-2 pr-4">Default</th>
                <th class="pb-2">Description</th>
              </tr>
            </thead>
            <tbody>
              {sstableOptions.map((opt) => (
                <tr class="border-t border-border" data-testid={`option-${opt.name}`}>
                  <td class="py-2 pr-4 font-mono text-accent">{opt.name}</td>
                  <td class="py-2 pr-4 text-text-secondary">{opt.type}</td>
                  <td class="py-2 pr-4 font-mono text-success" data-testid={`default-${opt.name}`}>{opt.default}</td>
                  <td class="py-2 text-text-primary">{opt.description}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </CollapsibleSection>

      <!-- Compaction Configuration -->
      <CollapsibleSection title="Compaction" testId="config-compaction" client:load>
        <div class="overflow-x-auto" data-testid="compaction-options">
          <table class="w-full text-sm">
            <thead>
              <tr class="text-text-secondary text-left">
                <th class="pb-2 pr-4">Option</th>
                <th class="pb-2 pr-4">Type</th>
                <th class="pb-2 pr-4">Default</th>
                <th class="pb-2">Description</th>
              </tr>
            </thead>
            <tbody>
              {compactionOptions.map((opt) => (
                <tr class="border-t border-border" data-testid={`option-${opt.name}`}>
                  <td class="py-2 pr-4 font-mono text-accent">{opt.name}</td>
                  <td class="py-2 pr-4 text-text-secondary">{opt.type}</td>
                  <td class="py-2 pr-4 font-mono text-success" data-testid={`default-${opt.name}`}>{opt.default}</td>
                  <td class="py-2 text-text-primary">{opt.description}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </CollapsibleSection>
    </div>

    <!-- Size Units Explanation -->
    <div class="mt-8 p-4 bg-surface border border-border rounded-lg" data-testid="size-units-section">
      <h3 class="text-lg font-mono text-text-primary mb-3">Size Units</h3>
      <p class="text-text-secondary text-sm mb-4">
        Configuration values that specify sizes support the following suffixes:
      </p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4" data-testid="size-units-grid">
        {sizeUnits.map((unit) => (
          <div class="text-center" data-testid={`size-unit-${unit.unit.toLowerCase()}`}>
            <span class="text-2xl font-mono text-accent font-bold">{unit.unit}</span>
            <p class="text-text-primary text-sm mt-1">{unit.name}</p>
            <p class="text-text-secondary text-xs">{unit.bytes}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
