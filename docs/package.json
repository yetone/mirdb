{
  "name": "mirdb-homepage",
  "version": "1.0.0",
  "description": "MirDB Homepage - Static site built with Hugo and Tailwind CSS",
  "scripts": {
    "dev": "hugo server --buildDrafts --buildFuture",
    "build": "hugo --minify",
    "css:build": "npx tailwindcss -i ./assets/css/main.css -o ./static/css/main.css --minify",
    "css:watch": "npx tailwindcss -i ./assets/css/main.css -o ./static/css/main.css --watch",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:headed": "npx playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "autoprefixer": "^10.4.18",
    "cssnano": "^6.0.5",
    "postcss": "^8.4.35",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^3.4.1"
  }
}
