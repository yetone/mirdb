{
  "name": "mirdb-homepage",
  "version": "1.0.0",
  "description": "MirDB Homepage - Persistent Key-Value Store with Memcached Protocol",
  "scripts": {
    "dev": "hugo server -D",
    "build": "hugo --minify",
    "test": "npx playwright test",
    "test:e2e": "npx playwright test tests/e2e/",
    "test:unit": "npx playwright test tests/unit/",
    "css:build": "npx tailwindcss -i ./assets/css/main.css -o ./static/css/style.css --minify"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "autoprefixer": "^10.4.16",
    "cssnano": "^6.0.1",
    "postcss": "^8.4.31",
    "postcss-cli": "^10.1.0",
    "tailwindcss": "^3.3.5"
  },
  "keywords": [
    "mirdb",
    "key-value",
    "memcached",
    "rust"
  ],
  "license": "MIT"
}
