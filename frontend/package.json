    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.18",
    "daisyui": "^4.7.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
