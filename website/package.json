{
  "name": "mirdb-homepage",
  "version": "1.0.0",
  "description": "MirDB Homepage static site",
  "scripts": {
    "start": "npx serve static -l 8080",
    "build": "node build.js",
    "test": "npm run test:integration && npm run test:e2e",
    "test:integration": "jest tests/integration --testTimeout=30000",
    "test:e2e": "npx playwright test",
    "test:headed": "npx playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "jest": "^30.2.0",
    "serve": "^14.2.0"
  }
}
