{
  "name": "mirdb-homepage",
  "version": "1.0.0",
  "description": "MirDB Product Homepage",
  "scripts": {
    "dev": "npx tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "build": "npx tailwindcss -i ./src/input.css -o ./dist/output.css --minify && cp ./src/index.html ./dist/index.html",
    "test": "node tests/hero-section.test.js",
    "test:e2e": "npx playwright test",
    "test:ui": "npx playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "jsdom": "^27.3.0",
    "tailwindcss": "^3.4.0"
  },
  "keywords": [],
  "author": "",
  "license": "MIT"
}
