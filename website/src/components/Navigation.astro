---
// Navigation component for MirDB product showcase
// Implements responsive navigation with desktop links and mobile hamburger menu
// REQ-10: Include responsive navigation that works on desktop and mobile
---

<nav data-testid="main-navigation" class="fixed top-0 left-0 right-0 z-50 bg-gray-900/95 backdrop-blur-sm border-b border-gray-800">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo / Brand -->
      <div class="flex-shrink-0">
        <a href="/" class="text-xl font-bold text-white">
          MirDB
        </a>
      </div>

      <!-- Desktop Navigation Links -->
      <div data-testid="desktop-nav-links" class="hidden md:block">
        <div class="ml-10 flex items-center space-x-8">
          <a
            data-testid="nav-home"
            href="#"
            class="text-gray-300 hover:text-white transition-colors text-sm font-medium"
          >
            Home
          </a>
          <a
            data-testid="nav-features"
            href="#features"
            class="text-gray-300 hover:text-white transition-colors text-sm font-medium"
          >
            Features
          </a>
          <a
            data-testid="nav-documentation"
            href="#getting-started"
            class="text-gray-300 hover:text-white transition-colors text-sm font-medium"
          >
            Documentation
          </a>
          <a
            data-testid="nav-github"
            href="https://github.com/mirdb/mirdb"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-300 hover:text-white transition-colors text-sm font-medium inline-flex items-center"
          >
            GitHub
            <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="md:hidden">
        <button
          data-testid="hamburger-menu"
          type="button"
          class="hamburger-button inline-flex items-center justify-center rounded-md p-2 text-gray-400 hover:bg-gray-800 hover:text-white focus:outline-none focus:ring-2 focus:ring-inset focus:ring-primary-500"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="sr-only">Open main menu</span>
          <!-- Hamburger icon -->
          <svg class="hamburger-icon block h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
          <!-- Close icon (hidden by default) -->
          <svg class="close-icon hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Menu (hidden by default) -->
  <div data-testid="mobile-nav-menu" id="mobile-menu" class="mobile-menu hidden md:hidden">
    <div class="space-y-1 px-4 pb-4 pt-2">
      <a
        data-testid="mobile-nav-home"
        href="#"
        class="mobile-nav-link block rounded-md px-3 py-2 text-base font-medium text-gray-300 hover:bg-gray-800 hover:text-white"
      >
        Home
      </a>
      <a
        data-testid="mobile-nav-features"
        href="#features"
        class="mobile-nav-link block rounded-md px-3 py-2 text-base font-medium text-gray-300 hover:bg-gray-800 hover:text-white"
      >
        Features
      </a>
      <a
        data-testid="mobile-nav-documentation"
        href="#getting-started"
        class="mobile-nav-link block rounded-md px-3 py-2 text-base font-medium text-gray-300 hover:bg-gray-800 hover:text-white"
      >
        Documentation
      </a>
      <a
        data-testid="mobile-nav-github"
        href="https://github.com/mirdb/mirdb"
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-nav-link block rounded-md px-3 py-2 text-base font-medium text-gray-300 hover:bg-gray-800 hover:text-white inline-flex items-center"
      >
        GitHub
        <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
      </a>
    </div>
  </div>
</nav>

<!-- Spacer to account for fixed navigation -->
<div class="h-16"></div>

<script>
  // Mobile menu toggle functionality
  document.addEventListener('DOMContentLoaded', () => {
    const hamburgerButton = document.querySelector('.hamburger-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.querySelector('.hamburger-icon');
    const closeIcon = document.querySelector('.close-icon');
    const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

    if (hamburgerButton && mobileMenu) {
      hamburgerButton.addEventListener('click', () => {
        const isExpanded = hamburgerButton.getAttribute('aria-expanded') === 'true';

        // Toggle menu visibility
        mobileMenu.classList.toggle('hidden');

        // Toggle icons
        hamburgerIcon?.classList.toggle('hidden');
        hamburgerIcon?.classList.toggle('block');
        closeIcon?.classList.toggle('hidden');
        closeIcon?.classList.toggle('block');

        // Update aria-expanded
        hamburgerButton.setAttribute('aria-expanded', (!isExpanded).toString());
      });

      // Close menu when a link is clicked
      mobileNavLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
          hamburgerIcon?.classList.remove('hidden');
          hamburgerIcon?.classList.add('block');
          closeIcon?.classList.add('hidden');
          closeIcon?.classList.remove('block');
          hamburgerButton.setAttribute('aria-expanded', 'false');
        });
      });
    }
  });
</script>
