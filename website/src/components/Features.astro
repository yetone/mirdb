---
// Features component for MirDB product showcase
// Displays key features in a responsive grid layout with 4 feature cards:
// 1. Memcached Protocol Compatible
// 2. Persistent Storage with SSTables
// 3. LSM Tree Architecture
// 4. High Performance with Rust

interface Feature {
  id: string;
  title: string;
  description: string;
  icon: string;
}

const features: Feature[] = [
  {
    id: 'memcached',
    title: 'Memcached Protocol',
    description: 'Full compatibility with the memcached protocol. Use any existing memcached client library to connect and interact with MirDB without code changes.',
    icon: 'protocol'
  },
  {
    id: 'persistence',
    title: 'Persistent Storage',
    description: 'Durable data storage using SSTables (Sorted String Tables). Your data persists to disk, surviving restarts and crashes with full durability guarantees.',
    icon: 'storage'
  },
  {
    id: 'lsm',
    title: 'LSM Tree Architecture',
    description: 'Built on a Log-Structured Merge-tree (LSM) architecture for optimal write performance. Data flows from memory through multiple levels for efficient storage.',
    icon: 'architecture'
  },
  {
    id: 'performance',
    title: 'High Performance',
    description: 'Written in Rust for maximum performance and memory safety. Achieve high throughput with low latency while maintaining reliability and efficiency.',
    icon: 'performance'
  }
];
---

<section data-testid="features-section" id="features" class="bg-gray-50 py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">
        Key Features
      </h2>
      <p class="mt-4 text-lg text-gray-600">
        MirDB combines the simplicity of memcached with enterprise-grade persistence and performance.
      </p>
    </div>

    <div data-testid="features-grid" class="mt-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {features.map((feature) => (
        <div
          data-testid={`feature-${feature.id}`}
          class="relative rounded-2xl bg-white p-8 shadow-sm ring-1 ring-gray-200 transition-shadow hover:shadow-md"
        >
          <div class="mb-4">
            {feature.icon === 'protocol' && (
              <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-primary-100 text-primary-600">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
                </svg>
              </div>
            )}
            {feature.icon === 'storage' && (
              <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-primary-100 text-primary-600">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
                </svg>
              </div>
            )}
            {feature.icon === 'architecture' && (
              <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-primary-100 text-primary-600">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0l4.179 2.25L12 21.75 2.25 16.5l4.179-2.25m11.142 0l-5.571 3-5.571-3" />
                </svg>
              </div>
            )}
            {feature.icon === 'performance' && (
              <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-primary-100 text-primary-600">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                </svg>
              </div>
            )}
          </div>
          <h3 data-testid={`feature-${feature.id}-title`} class="text-lg font-semibold text-gray-900">
            {feature.title}
          </h3>
          <p data-testid={`feature-${feature.id}-description`} class="mt-2 text-sm text-gray-600">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
